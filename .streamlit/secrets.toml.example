# Copy as .streamlit/secrets.toml, NEVER commit the real file.
# OIDC via Streamlit st.login (configure Google/Auth0/Entra provider).
[auth]
redirect_uri = "https://YOUR-DOMAIN/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET"
client_id = "OIDC_CLIENT_ID"
client_secret = "OIDC_CLIENT_SECRET"
server_metadata_url = "https://YOUR-OIDC-ISSUER/.well-known/openid-configuration"
